#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
#define SCREEN_ADDRESS 0x3C

// Initialize the OLED display
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// CHANGE YOUR TEXT HERE (Keep it up to 10 characters)
String customText = "Custom Text"; 
// REPLACE CUSTOM TEXT WITH YOUR TEXT
void setup() {
  Serial.begin(9600);

  // Initialize the OLED with I2C address 0x3C
  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
    for(;;);
  }

  // Clear the display buffer
  display.clearDisplay();

  // Configure text properties
  display.setTextSize(2);               // Size 2 = 12px wide, 16px high per character
  display.setTextColor(SSD1306_WHITE);    // Draw white text
  
  // Automatically center the text on the 128x64 screen
  int charWidth = 12;                   // Width of one character at text size 2
  int textLength = customText.length();
  int totalWidth = textLength * charWidth;
  
  int x = (SCREEN_WIDTH - totalWidth) / 2;
  int y = (SCREEN_HEIGHT - 16) / 2;     // 16 is the height of text size 2

  display.setCursor(x, y);
  display.print(customText);

  // Push the buffer to the physical screen
  display.display();
}

void loop() {
  // Nothing to do here
}
